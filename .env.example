###############################################################################
# Payments — Lenco API v2 (https://lenco-api.readme.io/v2.0)
#
# SANDBOX EVERYWHERE EXCEPT PRODUCTION. The secret key is server-side only;
# only LENCO_PUBLIC_KEY is ever exposed to the browser (inline widget).
###############################################################################

# sandbox or live. Picks the API host AND the widget host together, so the two
# can never be mismatched.
LENCO_ENVIRONMENT=live

LENCO_PUBLIC_KEY=
LENCO_SECRET_KEY=

# The Lenco account payouts and refunds are debited from. Required before any
# transfer can be sent.
LENCO_ACCOUNT_ID=

# Lenco signs webhooks with HMAC-SHA512 using the "webhook hash key", which is
# documented as the SHA-256 of the API token. Leave this blank and it is
# derived; set it only if the derived value turns out not to match.
LENCO_WEBHOOK_SECRET=

# Overrides. Lenco serves BOTH environments from the same REST host and tells
# them apart by the API token — only the widget host actually differs — so
# these are here for the day that changes, not for switching environments.
# LENCO_API_URL=https://api.lenco.co/access/v2
# LENCO_WIDGET_URL=https://pay.lenco.co/js/v1/inline.js


# Who pays Lenco's charge on a collection: merchant (default) or customer.
LENCO_FEE_BEARER=merchant

LENCO_HTTP_TIMEOUT=30

# The live sandbox test in tests/Feature/Payments/LencoSandboxTest.php is
# excluded from the suite and does nothing unless this is true.
# LENCO_SANDBOX_TESTS=false
# LENCO_SANDBOX_PAYOUT_TESTS=false

###############################################################################
# Hosting provisioning — Hestia control panel API
#
# Access key from Hestia (User > Access keys). Never commit real values.
# HESTIA_RESOLVE_IP pins the panel hostname to its LAN address, like
# curl --resolve, so the certificate is still verified.
###############################################################################

HESTIA_URL=https://srv2.varidianlab.com:8086/api/
HESTIA_ACCESS_KEY=ttDXlviNOLeG2IvDGUvP
HESTIA_SECRET_KEY=BCPWl=cx9i88KoArZL_9ub=yjnb0OdGSLhRSda8W
HESTIA_RESOLVE_IP=130.94.38.167
HESTIA_VERIFY_SSL=true
HESTIA_TIMEOUT=30
# Where customers log in to their control panel (shown in the welcome email).
HESTIA_PANEL_URL=https://srv2.varidianlab.com:8086


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
